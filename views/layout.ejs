<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header class="header">
        <div class="container header-inner">
            <a href="/" class="logo">🎒 <strong>Дима Сторыч</strong></a>
            <nav class="nav">
                <a href="/">Каталог</a>
                <a href="/cart" class="cart-link">
                    🛒 Корзина
                    <% if (cartCount > 0) { %>
                        <span class="cart-badge"><%= cartCount %></span>
                    <% } %>
                </a>
                <% if (isAdmin) { %>
                    <a href="/admin">⚙️ Админка</a>
                    <a href="/admin/logout">Выйти</a>
                <% } else { %>
                    <a href="/admin/login">🔐 Вход</a>
                <% } %>
            </nav>
        </div>
    </header>

    <main class="container">
        <%- body %>
    </main>

    <footer class="footer">
        <div class="container">
            <p>© 2024 <strong>Дима Сторыч</strong>. Все права защищены.</p>
            <p>Оплата через ЮKassa — безопасно и надёжно.</p>
        </div>
    </footer>
</body>
</html>
